# OAuth-facing placeholders for the public ChatGPT connector path.
# These values are documentation aids, not secrets.

NETWORK_MCP_PUBLIC_ORIGIN=https://example.workers.dev
NETWORK_MCP_OAUTH_ISSUER=https://example.auth0.com/
NETWORK_MCP_OAUTH_AUDIENCE=https://example.workers.dev
NETWORK_MCP_OAUTH_REQUIRED_SCOPE=network-mcp:read
NETWORK_MCP_OAUTH_CLIENT_ID=replace-with-public-client-id
NETWORK_MCP_AUTH0_ISSUER=https://example.auth0.com
NETWORK_MCP_OIDC_CLIENT_ID=replace-with-auth0-client-id
NETWORK_MCP_ALLOWED_EMAIL=user@example.com
