{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "network-mcp",
  "main": "./src/index.ts",
  // CAREER_WORKER_URL must point to the public Cloudflare Tunnel URL for the local playwright-worker.
  // If the browser worker is token-protected, set NETWORK_MCP_BROWSER_WORKER_TOKEN as a wrangler secret or environment variable before deploying this Worker.
  "compatibility_date": "2026-06-20",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
